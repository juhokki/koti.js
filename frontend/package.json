{
	"name": "@koti/frontend",
	"type": "module",
	"version": "1.0.0",
	"description": "Koti.js frontend",
	"main": "index.html",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"start": "vite",
		"build": "tsc -b && vite build",
