{
	"compilerOptions": {
		/* Base Options: */
		"noEmit": false,
		"target": "esnext",
		"module": "nodenext",
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,

		/* Strictness */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		/* Types */
		"types": ["node-ruuvitag-types"],

		/* Output */
		"outDir": "dist",
		"sourceMap": true
	}
}
