{
	"name": "@koti/ruuvi-sensor",
	"type": "module",
	"version": "1.0.0",
	"description": "Koti.js Ruuvi sensor",
	"main": "dist/index.js",
	"engines": {
		"node": ">=18.20.8"
	},
	"scripts": {
		"start": "node dist/index.js",
		"build": "npx tsc",
		"test": "npx vitest run",
		"test:coverage": "npx vitest run --coverage",
		"lint": "npx eslint",
		"prettier": "prettier --write ."
	},
	"dependencies": {
		"globals": "^17.11.0",
		"node-fetch": "^3.3.2",
		"node-ruuvitag": "github:juhokki/node-ruuvitag",
		"pino": "^9.13.1",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^8.57.1",
		"@types/node": "^26.2.0",
		"brace-expansion": "4.0.1",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.8",
		"node-ruuvitag-types": "github:juhokki/node-ruuvitag-types",
		"prettier": "^3.9.6",
		"typescript-eslint": "^7.18.0",
		"vitest": "^3.2.7"
	},
	"allowScripts": {
		"@abandonware/bluetooth-hci-socket@0.5.3-12": true,
		"@abandonware/noble@1.9.2-26": true,
		"usb@2.18.0": true
	}
